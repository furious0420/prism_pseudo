# Copy to backend/.env and fill in. NEVER commit the real .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
PRISM_S3_BUCKET=

# Local paths (Day 2-3)
# Relative paths resolve against backend/ regardless of where you run from.
PHI3_MODEL_PATH=models/Phi-3-mini-4k-instruct-q4.gguf
# Relative paths resolve against backend/, wherever you run from.
CHROMA_DIR=chroma_db

PORT=5000

# --- Day 2: local LLM ---
# Leave PRISM_LLM_BACKEND unset to auto-detect (Ollama first, then a .gguf).
# Force one with: ollama | llamacpp
PRISM_LLM_BACKEND=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
PRISM_N_CTX=4096
PRISM_N_GPU_LAYERS=-1
PRISM_LLM_CONNECT_TIMEOUT=5
PRISM_LLM_READ_TIMEOUT=180
# Hold the model in VRAM between calls. "-1" = never unload while the server runs.
# Without this, an evicted model reloads mid-demo and looks like a 10-13s hang.
PRISM_OLLAMA_KEEP_ALIVE=-1
